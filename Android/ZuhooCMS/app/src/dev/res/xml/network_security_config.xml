<?xml version="1.0" encoding="utf-8"?>
<!--
    DEV flavor only.

    Replaces the app-wide android:usesCleartextTraffic="true" that used to sit in the manifest.
    That flag allowed plaintext HTTP to *any* host in every build; this narrows it to the local
    backend hosts a developer actually talks to, and the prod flavor's copy of this file allows
    none at all.
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <!-- Debug builds also trust user-installed CAs so tools like Charles or mitmproxy
                 can be used against the dev backend. Never present in release. -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- The emulator's alias for the host machine's loopback. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Add your machine's LAN IP here when testing on a physical device, e.g.
             <domain includeSubdomains="false">192.168.1.106</domain> -->
    </domain-config>

</network-security-config>
