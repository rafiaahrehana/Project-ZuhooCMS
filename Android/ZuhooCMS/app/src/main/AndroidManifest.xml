<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime permission from API 33; ignored on older releases, where notifications are
         granted at install time. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- For attendance check-in/out geofencing. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- For the attendance check-in selfie. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".ZuhooApplication"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zuhoo"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.ClientRegisterActivity"
            android:exported="false"
            android:parentActivityName=".ui.auth.LoginActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.CompleteGoogleSignupActivity"
            android:exported="false"
            android:parentActivityName=".ui.auth.LoginActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false"
            android:parentActivityName=".ui.auth.LoginActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.ResetPasswordActivity"
            android:exported="false"
            android:parentActivityName=".ui.auth.ForgotPasswordActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.VerifyEmailActivity"
            android:exported="false"
            android:parentActivityName=".ui.auth.LoginActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.CompanyOwnerRegisterActivity"
            android:exported="false"
            android:parentActivityName=".ui.auth.LoginActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.servicerequest.ServiceRequestListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.servicerequest.CreateServiceRequestActivity"
            android:exported="false"
            android:parentActivityName=".ui.servicerequest.ServiceRequestListActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.servicerequest.ServiceRequestDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.servicerequest.ServiceRequestListActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.invoice.InvoiceListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.invoice.InvoiceDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.invoice.InvoiceListActivity" />

        <activity
            android:name=".ui.payment.PaymentActivity"
            android:exported="false"
            android:parentActivityName=".ui.invoice.InvoiceListActivity" />

        <activity
            android:name=".ui.payment.PaymentReceiptListActivity"
            android:exported="false"
            android:parentActivityName=".ui.invoice.InvoiceListActivity" />

        <activity
            android:name=".ui.payment.SubscriptionListActivity"
            android:exported="false"
            android:parentActivityName=".ui.invoice.InvoiceListActivity" />

        <activity
            android:name=".ui.catalog.CatalogActivity"
            android:exported="false" />

        <activity
            android:name=".ui.catalog.PackageListActivity"
            android:exported="false"
            android:parentActivityName=".ui.catalog.CatalogActivity" />

        <activity
            android:name=".ui.servicerequest.StaffServiceRequestListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.support.SupportTicketListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.support.CreateSupportTicketActivity"
            android:exported="false"
            android:parentActivityName=".ui.support.SupportTicketListActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.support.SupportTicketDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.support.SupportTicketListActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.account.AccountActivity"
            android:exported="false" />

        <activity
            android:name=".ui.account.EditProfileActivity"
            android:exported="false"
            android:parentActivityName=".ui.account.AccountActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.account.ClientProfileActivity"
            android:exported="false"
            android:parentActivityName=".ui.account.AccountActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.notification.NotificationListActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.DashboardActivity" />

        <activity
            android:name=".ui.notification.NotificationPreferencesActivity"
            android:exported="false"
            android:parentActivityName=".ui.account.AccountActivity" />

        <activity
            android:name=".ui.kb.KbArticleListActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.DashboardActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.kb.KbArticleDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.kb.KbArticleListActivity" />

        <activity
            android:name=".ui.attendance.CheckInActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.DashboardActivity" />

        <activity
            android:name=".ui.attendance.AttendanceLocationSettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.account.AccountActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.leave.LeaveRequestListActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.DashboardActivity" />

        <activity
            android:name=".ui.leave.CreateLeaveRequestActivity"
            android:exported="false"
            android:parentActivityName=".ui.leave.LeaveRequestListActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.leave.LeaveApprovalListActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.DashboardActivity" />

        <activity
            android:name=".ui.payroll.PayslipListActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.DashboardActivity" />

        <activity
            android:name=".ui.noticeboard.NoticeBoardActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.DashboardActivity" />

        <activity
            android:name=".ui.expense.ExpenseListActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.DashboardActivity" />

        <activity
            android:name=".ui.expense.CreateExpenseActivity"
            android:exported="false"
            android:parentActivityName=".ui.expense.ExpenseListActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.expense.ExpenseApprovalListActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.DashboardActivity" />

        <activity
            android:name=".ui.overview.CompanyOverviewActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.DashboardActivity" />

        <activity
            android:name=".ui.crm.LeadListActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.DashboardActivity" />

        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.DashboardActivity" />

        <activity
            android:name=".ui.wallet.WalletActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.DashboardActivity" />

        <activity
            android:name=".ui.directory.DirectoryActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.DashboardActivity" />

        <activity
            android:name=".ui.timesheet.TimesheetListActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.DashboardActivity" />

        <!-- exported="false": only FCM binds this, via its own signature-protected permission. -->
        <service
            android:name=".push.ZuhooMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>