<?xml version="1.0" encoding="utf-8"?>
<!-- Follows the app's detail-screen pattern (see activity_invoice_detail.xml): an unboxed
     header (title + status + metadata), the substantive content grouped into bg_card sections,
     then action buttons using the primary/secondary hierarchy. This screen has more distinct
     kinds of content than most detail screens, so it gets three content cards instead of one —
     request details, quotation (existing show/hide block), and the status timeline — plus the
     comment thread as its own card-list section at the end. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingTop="@dimen/screen_padding_v"
        android:paddingBottom="@dimen/space_32">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/detailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Zuhoo.TitleLarge" />

            <TextView
                android:id="@+id/detailStatusBadge"
                style="@style/Widget.Zuhoo.StatusBadge"
                android:layout_marginStart="@dimen/space_8" />

        </LinearLayout>

        <TextView
            android:id="@+id/detailHubService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:textAppearance="@style/TextAppearance.Zuhoo.BodyMedium" />

        <!-- Request details: description + agreed price + assignment, the core facts of the
             request grouped into one card. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/detailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Zuhoo.BodyLarge" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_width"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginBottom="@dimen/space_12"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_agreed_price"
                    android:textAppearance="@style/TextAppearance.Zuhoo.BodyMedium" />

                <TextView
                    android:id="@+id/detailPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Zuhoo.TitleSmall" />

            </LinearLayout>

            <TextView
                android:id="@+id/detailAssignedTo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.Zuhoo.BodyMedium" />

        </LinearLayout>

        <!-- Quotation: same show/hide-by-data behavior as before, just restyled as a card. -->
        <LinearLayout
            android:id="@+id/quotationSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding"
            android:visibility="gone">

            <TextView
                android:id="@+id/quotationAmountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Zuhoo.TitleSmall"
                android:textColor="@color/brand_primary" />

            <TextView
                android:id="@+id/quotationNotesText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.Zuhoo.BodyMedium" />

            <LinearLayout
                android:id="@+id/quotationActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAcceptQuotation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_accept_quotation" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRejectQuotation"
                    style="@style/Widget.Zuhoo.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:text="@string/action_reject_quotation" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:text="@string/action_cancel_request"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLeaveReview"
            style="@style/Widget.Zuhoo.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/action_leave_review"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/staffActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAssignRequest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_assign_request" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeStatus"
                style="@style/Widget.Zuhoo.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/action_change_status" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitQuotationStaff"
                style="@style/Widget.Zuhoo.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/action_submit_quotation" />

        </LinearLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/space_16"
            android:indeterminate="true"
            app:indicatorColor="@color/brand_primary"
            android:visibility="gone" />

        <!-- Status timeline. Rows are added in code from GET /{id}/history — the shape is a
             flat list of transitions, so a container beats a second RecyclerView here. -->
        <LinearLayout
            android:id="@+id/timelineSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_timeline_heading"
                android:textAppearance="@style/TextAppearance.Zuhoo.TitleMedium" />

            <LinearLayout
                android:id="@+id/timelineContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="vertical" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/section_comments"
                android:textAppearance="@style/TextAppearance.Zuhoo.TitleMedium" />

            <TextView
                android:id="@+id/chatStatusIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_status_connecting"
                android:textAppearance="@style/TextAppearance.Zuhoo.BodySmall" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/commentsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_comment" />

        <!-- Shown once a file is picked and uploaded; tapping it clears the attachment. -->
        <TextView
            android:id="@+id/attachmentChip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textAppearance="@style/TextAppearance.Zuhoo.BodySmall"
            android:textColor="@color/brand_primary"
            android:visibility="gone" />

        <!-- Compose bar: bg_card gives the input row the same flat-bordered treatment as every
             other container on the screen, rather than a bare unstyled EditText. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_padding_compact">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAttach"
                style="@style/Widget.Zuhoo.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="@dimen/space_8"
                android:paddingEnd="@dimen/space_8"
                android:text="@string/action_attach" />

            <EditText
                android:id="@+id/commentInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/hint_comment"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="3"
                android:textAppearance="@style/TextAppearance.Zuhoo.BodyMedium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:minWidth="0dp"
                android:text="@string/action_send" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
