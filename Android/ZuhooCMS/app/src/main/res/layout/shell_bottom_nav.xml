<?xml version="1.0" encoding="utf-8"?>
<!-- Wrapper that BottomNavActivity puts around a screen's own layout. Screens keep whatever
     root they already had; their view is dropped into contentFrame at runtime. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Hairline divider instead of the nav bar's default shadow/elevation — a flat 1dp line
         separates content from chrome without the drop-shadow look the rest of the app avoids. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_width"
        android:background="@color/divider" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.Zuhoo.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp" />

</LinearLayout>
