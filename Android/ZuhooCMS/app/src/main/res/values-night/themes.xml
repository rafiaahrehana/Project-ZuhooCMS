<resources>

    <style name="Zuhoo.ActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/chrome_black</item>
        <item name="titleTextColor">@color/white</item>
    </style>

    <!-- Base application theme. -->
    <style name="Theme.Zuhoo" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_deep</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorSecondaryVariant">@color/brand_primary_hover</item>
        <item name="colorOnSecondary">@color/brand_deep</item>
        <item name="actionBarStyle">@style/Zuhoo.ActionBar</item>
        <item name="android:statusBarColor">@color/chrome_black</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
