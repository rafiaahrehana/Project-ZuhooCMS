<?xml version="1.0" encoding="utf-8"?>
<!-- Same card as bg_card, with a ripple clipped to its rounded corners — used for list items
     and any other tappable card so touch feedback doesn't spill outside the shape as a square. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/border">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_card" />
</ripple>
