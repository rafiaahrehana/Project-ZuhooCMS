# Copy to keystore.properties (which is gitignored) and fill in before building a release.
# Generate a keystore with:
#   keytool -genkey -v -keystore zuhoo-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias zuhoo
#
# Keep the .jks file OUT of this repository. Losing it means you can never ship an update to the
# same Play Store listing again.
storeFile=../zuhoo-release.jks
storePassword=
keyAlias=zuhoo
keyPassword=
