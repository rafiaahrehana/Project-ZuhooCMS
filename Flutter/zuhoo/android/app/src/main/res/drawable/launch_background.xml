<?xml version="1.0" encoding="utf-8"?>
<!-- The window Android paints while the process starts, before Flutter's first
     frame. Android 12 and up ignore this and draw the launcher icon instead;
     this is what everything older sees. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
