# Copy this file's contents into your actual environment (shell profile, IDE run
# config, or a local .env loaded by your process manager) - never commit real values.
# Spring Boot reads these directly as OS environment variables; this repo does not
# use a .env-loading library, so a literal ".env" file won't be picked up automatically
# unless your run configuration sources it into the process environment.

# Database (required - app will fail to start without these)
DB_URL=jdbc:postgresql://localhost:5432/businessops
DB_USERNAME=postgres
DB_PASSWORD=

# JWT signing secret (required) - generate a new random 256-bit value, e.g.:
#   openssl rand -hex 32
JWT_SECRET=

# Mail (required if email features are used)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# AI providers (optional - leave blank to disable a provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=

# Frontend URL (optional, defaults to http://localhost:4200)
FRONTEND_URL=http://localhost:4200

# File upload directory (optional, defaults to ./assets)
IMAGE_UPLOAD_DIR=

# Payment gateways (optional - defaults to sandbox/test credentials if unset)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=

NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_BASE_URL=

ROCKET_MERCHANT_ID=
ROCKET_PASSWORD=
ROCKET_BASE_URL=
